model InventoryStore {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name                     String
  type                     String                           @default("SUB")
  location                 String?
  managerId                String? @db.Uuid
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  coveringRt               String?
  gpsLocation              String?
  officeAdminId            String? @db.Uuid
  balanceSheets            ContractorMaterialBalanceSheet[] @relation("BalanceSheets")
  materialIssues           ContractorMaterialIssue[]        @relation("MaterialIssues")
  materialReturns          ContractorMaterialReturn[]       @relation("MaterialReturns")
  wastageReports           ContractorWastage[]
  grns                     GRN[]
  itAssets                 ITAsset[]
  officeAssetMovementsFrom OfficeAssetMovementLog[]         @relation("MovedFromSite")
  officeAssetMovementsTo   OfficeAssetMovementLog[]         @relation("MovedToSite")
  officeAssets             OfficeAsset[]
  batchStocks              InventoryBatchStock[]
  serials                  InventoryItemSerial[]
  stocks                   InventoryStock[]
  manager                  User?                            @relation(fields: [managerId], references: [id])
  officeAdmin              User?                            @relation("SiteOfficeAdmin", fields: [officeAdminId], references: [id])
  transactions             InventoryTransaction[]
  mrns                     MRN[]
  opmcs                    OPMC[]
  projectReturns           ProjectMaterialReturn[]
  agreements               SiteOfficeAgreement[]
  requests                 SiteOfficeRequest[]
  tenders                  SiteOfficeTender[]
  vehicles                 SiteOfficeVehicle[]
  stockIssues              StockIssue[]                     @relation("StockIssues")
  outRequests              StockRequest[]                   @relation("RequestSource")
  inRequests               StockRequest[]                   @relation("RequestTarget")
  teamAssignments          TeamStoreAssignment[]
  assignedUsers            User[]                           @relation("UserAssignedStore")
  locators                 WarehouseLocator[]
  cycleCounts              CycleCountHeader[]
  ledgers                  InventoryLedger[]

  @@index([type])
  @@index([managerId])
  @@index([officeAdminId])
}

model InventoryItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code                  String                         @unique
  name                  String
  description           String?
  unit                  String
  type                  String                         @default("SLTS")
  category              String                         @default("OTHERS")
  minLevel              Decimal                        @default(0)
  isWastageAllowed      Boolean                        @default(true)
  maxWastagePercentage  Decimal                        @default(0)
  hasSerial             Boolean                        @default(false)
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt
  source                String                         @default("SLT")
  commonFor             String[]
  unitPrice             Decimal?                       @default(0)
  costPrice             Decimal?                       @default(0)
  commonName            String?
  sltCode               String?
  isOspFtth             Boolean?                       @default(false)
  importAliases         String[]
  scrapedAliases        String[]                       @default([])
  bomAliases            String[]                       @default([])
  balanceSheetItems     ContractorBalanceSheetItem[]   @relation("BalanceSheetItems")
  contractorBatchStocks ContractorBatchStock[]
  issueItems            ContractorMaterialIssueItem[]  @relation("IssueItems")
  returnItems           ContractorMaterialReturnItem[] @relation("ReturnItems")
  contractorStock       ContractorStock[]
  wastageItems          ContractorWastageItem[]
  grnItems              GRNItem[]
  batches               InventoryBatch[]
  batchStocks           InventoryBatchStock[]
  serials               InventoryItemSerial[]
  stocks                InventoryStock[]
  transactionItems      InventoryTransactionItem[]
  mrnItems              MRNItem[]
  materialStandards     MaterialStandard[]             @relation("MaterialStandards")
  boqItems              ProjectBOQItem[]               @relation("BOQMaterials")
  projectReturnItems    ProjectMaterialReturnItem[]    @relation("ProjectReturnItems")
  sodUsage              SODMaterialUsage[]             @relation("SODUsage")
  stockIssueItems       StockIssueItem[]               @relation("IssueItemsStock")
  requestItems          StockRequestItem[]
  cycleCountLines       CycleCountLine[]
  preErpBalances        PreErpMaterialBalance[]
  varianceAdjustments   MaterialVarianceAdjustment[]
  ledgers               InventoryLedger[]

  @@index([code])
  @@index([type])
  @@index([category])
  @@index([commonName])
}

model InventoryStock {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  storeId           String @db.Uuid
  itemId            String @db.Uuid
  quantity          Decimal        @default(0)
  allocatedQuantity Decimal        @default(0)
  minLevel          Decimal        @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  item              InventoryItem  @relation(fields: [itemId], references: [id])
  store             InventoryStore @relation(fields: [storeId], references: [id])

  @@unique([storeId, itemId])
  @@index([storeId])
  @@index([itemId])
}

model InventoryBatch {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  batchNumber      String?
  itemId           String @db.Uuid
  grnId            String? @db.Uuid
  initialQty       Decimal
  costPrice        Decimal                    @default(0)
  unitPrice        Decimal                    @default(0)
  createdAt        DateTime                   @default(now())
  expiryDate       DateTime?
  contractorStocks ContractorBatchStock[]
  grnItem          GRNItem?
  grn              GRN?                       @relation(fields: [grnId], references: [id])
  item             InventoryItem              @relation(fields: [itemId], references: [id])
  storeStocks      InventoryBatchStock[]
  transactionItems InventoryTransactionItem[]
  usageItems       SODMaterialUsage[]
  cycleCountLines  CycleCountLine[]

  @@index([itemId])
  @@index([createdAt])
  @@index([expiryDate])
  @@index([grnId])
}

model InventoryBatchStock {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  storeId           String @db.Uuid
  itemId            String @db.Uuid
  batchId           String @db.Uuid
  quantity          Decimal           @default(0)
  allocatedQuantity Decimal           @default(0)
  updatedAt         DateTime          @updatedAt
  locatorId         String? @db.Uuid
  batch             InventoryBatch    @relation(fields: [batchId], references: [id])
  item              InventoryItem     @relation(fields: [itemId], references: [id])
  store             InventoryStore    @relation(fields: [storeId], references: [id])
  locator           WarehouseLocator? @relation(fields: [locatorId], references: [id])

  @@unique([storeId, batchId])
  @@index([storeId])
  @@index([itemId])
  @@index([batchId])
  @@index([locatorId])
}

model InventoryTransaction {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type        String
  storeId     String @db.Uuid
  referenceId String? @db.Uuid
  notes       String?
  date        DateTime                   @default(now())
  userId      String @db.Uuid
  store       InventoryStore             @relation(fields: [storeId], references: [id])
  items       InventoryTransactionItem[]

  @@index([storeId])
  @@index([type])
  @@index([date])
  @@index([referenceId])
  @@index([userId])
}

model InventoryTransactionItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  transactionId String @db.Uuid
  itemId        String @db.Uuid
  quantity      Decimal
  batchId       String? @db.Uuid
  batch         InventoryBatch?      @relation(fields: [batchId], references: [id])
  item          InventoryItem        @relation(fields: [itemId], references: [id])
  transaction   InventoryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  @@index([transactionId])
  @@index([itemId])
  @@index([batchId])
}

model MaterialCategory {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name        String             @unique
  description String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  standards   MaterialStandard[]
}

model MaterialStandard {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  categoryId     String @db.Uuid
  packageType    String
  itemId         String @db.Uuid
  standardQty    Decimal
  maxQty         Decimal?
  wastagePercent Decimal          @default(5)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  category       MaterialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  item           InventoryItem    @relation("MaterialStandards", fields: [itemId], references: [id])

  @@unique([categoryId, packageType, itemId])
  @@index([packageType])
  @@index([categoryId])
  @@index([itemId])
}

model CurrentStock {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  storeId   String @db.Uuid
  itemId    String @db.Uuid
  quantity  Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, itemId])
  @@index([storeId])
  @@index([itemId])
}

model InventoryItemSerial {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  itemId          String @db.Uuid
  serialNumber    String             @unique
  status          String             @default("IN_STORE")
  storeId         String? @db.Uuid
  contractorId    String? @db.Uuid
  sodId           String? @db.Uuid
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  assignedStaffId String? @db.Uuid
  locator         String?
  assignedStaff   Staff?             @relation(fields: [assignedStaffId], references: [id])
  contractor      Contractor?        @relation(fields: [contractorId], references: [id])
  item            InventoryItem      @relation(fields: [itemId], references: [id])
  store           InventoryStore?    @relation(fields: [storeId], references: [id])
  sodUsages       SODMaterialUsage[]

  @@index([itemId])
  @@index([storeId])
  @@index([contractorId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([sodId])
}

model JournalEntry {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  referenceId    String? @db.Uuid
  referenceType  String?
  idempotencyKey String?       @unique
  sha256Hash     String?
  description    String
  status         String        @default("DRAFT") // DRAFT, PENDING_APPROVAL, POSTED, REVERSED
  isLocked       Boolean       @default(false)
  postedAt       DateTime?
  createdById    String? @db.Uuid
  approvedById   String? @db.Uuid
  reversalOfId   String? @db.Uuid
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  lines          JournalLine[]

  @@index([referenceId, referenceType])
  @@index([status])
  @@index([idempotencyKey])
  @@index([createdById])
  @@index([approvedById])
  @@index([reversalOfId])
}

model JournalLine {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  entryId      String @db.Uuid
  accountCode  String
  accountName  String
  debit        Decimal         @default(0)
  credit       Decimal         @default(0)
  description  String?
  currency     String          @default("LKR")
  exchangeRate Decimal @db.Decimal(14, 2) @default(1.0)
  entry        JournalEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount? @relation(fields: [accountCode], references: [code], onDelete: Restrict)

  @@index([entryId])
  @@index([accountCode])
}

model WarehouseLocator {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  storeId              String @db.Uuid
  code                 String
  aisle                String?
  rack                 String?
  shelf                String?
  bin                  String?
  description          String?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  store                InventoryStore        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryBatchStocks InventoryBatchStock[]

  @@unique([storeId, code])
  @@index([storeId])
  @@index([code])
}

model CycleCountHeader {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  countNumber        String           @unique
  storeId            String @db.Uuid
  status             String           @default("DRAFT")
  countType          String           @default("BLIND")
  plannedDate        DateTime         @default(now())
  completedDate      DateTime?
  countedById        String @db.Uuid
  approvedById       String? @db.Uuid
  remarks            String?
  totalVarianceValue Decimal          @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  store              InventoryStore   @relation(fields: [storeId], references: [id])
  countedBy          User             @relation("CycleCounter", fields: [countedById], references: [id])
  approvedBy         User?            @relation("CycleApprover", fields: [approvedById], references: [id])
  lines              CycleCountLine[]

  @@index([storeId])
  @@index([status])
  @@index([countNumber])
  @@index([countedById])
  @@index([approvedById])
}

model CycleCountLine {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  headerId      String @db.Uuid
  itemId        String @db.Uuid
  batchId       String? @db.Uuid
  systemQty     Decimal          @default(0)
  countedQty    Decimal          @default(0)
  varianceQty   Decimal          @default(0)
  unitCost      Decimal          @default(0)
  varianceValue Decimal          @default(0)
  notes         String?
  header        CycleCountHeader @relation(fields: [headerId], references: [id], onDelete: Cascade)
  item          InventoryItem    @relation(fields: [itemId], references: [id])
  batch         InventoryBatch?  @relation(fields: [batchId], references: [id])

  @@index([headerId])
  @@index([itemId])
  @@index([batchId])
}

model DocumentCounter {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type     String // MIN | MRN | GRN | ISS | GRN-IR | ISS-IR | MRN-IR
  period   String // YYYY-MM
  sequence Int    @default(0)

  @@unique([type, period])
}

model InventoryLedger {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  storeId          String @db.Uuid
  itemId           String @db.Uuid
  batchId          String? @db.Uuid
  transactionType  String // GRN_RECEIPT, CONTRACTOR_ISSUE, CONTRACTOR_RETURN, MRN_APPROVAL, SOD_INSTALLATION, WASTAGE_ADJUSTMENT, CYCLE_COUNT_CORRECTION
  referenceType    String // GRN, ContractorMaterialIssue, SOD, MRN, CycleCount
  referenceId      String // free-form: may be a document number (GRN-xxx, requestNr), not always a UUID
  quantityBefore   Decimal  @default(0) @db.Decimal(12, 4)
  quantityChange   Decimal  @default(0) @db.Decimal(12, 4)
  quantityAfter    Decimal  @default(0) @db.Decimal(12, 4)
  unitPrice        Decimal  @default(0) @db.Decimal(12, 2)
  totalValue       Decimal  @default(0) @db.Decimal(14, 2)
  performedById    String? @db.Uuid // nullable: 'SYSTEM'/automation actors store null
  idempotencyKey   String?  @unique
  previousChecksum String?
  checksum         String // SHA-256 hash of (id + storeId + itemId + quantityAfter + createdAt + previousChecksum)
  createdAt        DateTime @default(now())

  store       InventoryStore @relation(fields: [storeId], references: [id])
  item        InventoryItem  @relation(fields: [itemId], references: [id])
  performedBy User?          @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@index([storeId, itemId, createdAt])
  @@index([referenceType, referenceId])
  @@index([transactionType])
  @@index([batchId])
  @@index([performedById])
}
