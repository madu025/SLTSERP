model OspPettyCashIou {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  iouNumber      String
  opmcId         String?   @db.Uuid
  staffName      String
  staffServiceNo String?
  type           String    @default("PETTY_CASH")
  amount         Decimal   @db.Decimal(14, 2)
  issuedDate     DateTime?
  reason         String?
  noOfDays       Int?      @default(0)
  status         String    @default("PENDING")
  approvedAt     DateTime?
  remarks        String?
  /// the float this IOU is issued against (null for IOUs recorded before floats)
  floatId         String?   @db.Uuid
  /// bills handed in plus cash returned
  settledAmount   Decimal   @default(0) @db.Decimal(14, 2)
  /// OPEN | PARTIALLY_SETTLED | SETTLED
  settlementStatus String   @default("OPEN")
  settledAt       DateTime?
  createdById  String?   @db.Uuid
  approvedById String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([iouNumber, staffName])
  @@index([opmcId])
  @@index([status])
  @@index([type])
}

model OspProjectAdvance {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  refNumber    String    @unique
  type         String    @default("PROJECT")
  supplierName String?
  description  String
  invoiceNo    String?
  amount       Decimal   @db.Decimal(14, 2)
  vatAmount    Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount  Decimal   @db.Decimal(14, 2)
  status       String    @default("PENDING")
  approvedAt   DateTime?
  opmcId       String?   @db.Uuid
  createdById  String?   @db.Uuid
  approvedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([opmcId])
  @@index([status])
}

model OspPropertyRentPayment {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountNo    String?
  supplierName String
  amount       Decimal   @db.Decimal(14, 2)
  category     String    @default("Office Rent")
  slipNo       String
  slipDate     DateTime?
  status       String    @default("PENDING")
  approvedAt   DateTime?
  opmcId       String?   @db.Uuid
  createdById  String?   @db.Uuid
  approvedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([supplierName, slipNo])
  @@index([opmcId])
  @@index([category])
  @@index([status])
}

model OspFuelDepositLedger {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  officeLocation String
  opmcId         String?   @db.Uuid
  stationName    String
  actualDeposit  Decimal   @db.Decimal(14, 2)
  status         String    @default("PENDING")
  approvedAt     DateTime?
  createdById  String?   @db.Uuid
  approvedById String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

