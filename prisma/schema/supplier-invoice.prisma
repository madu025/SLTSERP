/// A vendor's bill for goods ordered on a purchase order (store or project). It is matched against what was ordered and
/// what was actually received (accepted) before it can be approved: the 3-way match.
model SupplierInvoice {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  /// The vendor's own invoice number, unique per vendor
  invoiceNumber   String
  vendorId        String    @db.Uuid
  storePoId       String?   @db.Uuid
  projectPoId     String?   @db.Uuid
  invoiceDate     DateTime
  dueDate         DateTime?
  currency        String    @default("LKR")
  subtotal        Decimal   @default(0) @db.Decimal(14, 2)
  taxAmount       Decimal   @default(0) @db.Decimal(14, 2)
  totalAmount     Decimal   @default(0) @db.Decimal(14, 2)
  /// DRAFT | MATCHED | VARIANCE | APPROVED | PAID | REJECTED
  status          String    @default("DRAFT")
  /// MATCHED | VARIANCE | PENDING (not yet matched)
  matchStatus     String    @default("PENDING")
  matchDetail     Json?
  overrideReason  String?
  rejectionReason String?
  createdById     String    @db.Uuid
  approvedById    String?   @db.Uuid
  approvedAt      DateTime?
  paidAt          DateTime?
  journalEntryId  String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor    Vendor                @relation(fields: [vendorId], references: [id])
  storePo   PurchaseOrder?        @relation(fields: [storePoId], references: [id])
  projectPo ProjectPurchaseOrder? @relation(fields: [projectPoId], references: [id])
  items     SupplierInvoiceItem[]

  @@unique([vendorId, invoiceNumber])
  @@index([storePoId])
  @@index([projectPoId])
  @@index([status])
  @@index([vendorId, status])
}

model SupplierInvoiceItem {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceId   String  @db.Uuid
  /// PurchaseOrderItem.id or ProjectPurchaseOrderItem.id, depending on which PO the invoice is for
  poItemId    String  @db.Uuid
  description String?
  quantity    Decimal @db.Decimal(12, 4)
  unitPrice   Decimal @db.Decimal(14, 2)
  taxAmount   Decimal @default(0) @db.Decimal(14, 2)
  amount      Decimal @db.Decimal(14, 2)

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([poItemId])
}
