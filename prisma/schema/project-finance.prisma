model Invoice {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceNumber     String                    @unique
  contractorId      String @db.Uuid
  projectId         String? @db.Uuid
  year              Int?
  month             Int?
  totalAmount       Decimal                   @default(0)
  amountA           Decimal                   @default(0)
  statusA           InvoiceStatus             @default(PENDING)
  paidDateA         DateTime?
  amountB           Decimal                   @default(0)
  statusB           InvoiceStatus             @default(HOLD)
  paidDateB         DateTime?
  amount            Decimal
  status            InvoiceStatus             @default(PENDING)
  approvalStatus    String                    @default("DRAFT")
  idempotencyKey    String?                   @unique
  retentionAmount   Decimal                   @default(0)
  advanceDeduction  Decimal                   @default(0)
  description       String?
  vatAmount         Decimal                   @default(0)
  ssclAmount        Decimal                   @default(0)
  whtAmount         Decimal                   @default(0)
  vatPercent        Decimal @db.Decimal(8, 4) @default(18)
  ssclPercent       Decimal @db.Decimal(8, 4) @default(2.5)
  whtPercent        Decimal @db.Decimal(8, 4) @default(5)
  dueDate           DateTime?
  date              DateTime                  @default(now())
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  agreementNumber   String?
  bomNumber         String?
  connectionTitle   String?
  projectNumber     Int?
  rtomArea          String?
  contractor        Contractor                @relation(fields: [contractorId], references: [id])
  project           Project?                  @relation(fields: [projectId], references: [id])
  penalties         Penalty[]
  sods              ServiceOrder[]
  amendmentRequests InvoiceAmendmentRequest[]

  @@index([projectId])
  @@index([contractorId])
}

model InvoiceAmendmentRequest {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceId        String @db.Uuid
  originalAmount   Decimal
  requestedAmount  Decimal
  originalAmountA  Decimal
  requestedAmountA Decimal
  originalAmountB  Decimal
  requestedAmountB Decimal
  reason           String
  status           String    @default("PENDING_SF_APPROVAL")
  requestedById    String @db.Uuid
  approvedById     String? @db.Uuid
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  requestedBy      User      @relation("AmendmentRequestedBy", fields: [requestedById], references: [id])
  approvedBy       User?     @relation("AmendmentApprovedBy", fields: [approvedById], references: [id])

  @@index([invoiceId])
  @@index([status])
  @@index([requestedById])
  @@index([approvedById])
}

model Bank {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code      String       @unique
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  branches  BankBranch[]
}

model BankBranch {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bankId    String @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bank      Bank     @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, code])
  @@index([bankId])
}

model Vendor {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  code           String               @unique
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  registrationNo String?
  brNumber       String?
  bankName       String?
  bankBranch     String?
  bankAccountNo  String?
  status         String               @default("ACTIVE")
  type           String               @default("SUPPLIER")
  paymentTerms   String?
  rating         Int?                 @default(0)
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  requisitions   ProjectRequisition[] @relation("VendorRequisitions")
  quotations     Quotation[]

  @@index([status])
  @@index([type])
  @@index([code])
}

model ProjectRequisition {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  prNumber         String                   @unique
  projectId        String @db.Uuid
  title            String
  description      String?
  priority         String                   @default("MEDIUM")
  status           String                   @default("DRAFT")
  type             String                   @default("MATERIAL")
  deliveryLocation String?
  requiredDate     DateTime?
  requestedById    String @db.Uuid
  approvedById     String? @db.Uuid
  approvedAt       DateTime?
  rejectionReason  String?
  vendorId         String? @db.Uuid
  estimatedTotal   Decimal @db.Decimal(14, 2) @default(0)
  remarks          String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  purchaseOrders   ProjectPurchaseOrder[]
  project          Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor           Vendor?                  @relation("VendorRequisitions", fields: [vendorId], references: [id])
  items            ProjectRequisitionItem[]
  quotations       Quotation[]              @relation("RequisitionQuotations")

  @@index([projectId])
  @@index([status])
  @@index([prNumber])
  @@index([vendorId])
  @@index([requestedById])
  @@index([approvedById])
}

model ProjectRequisitionItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  requisitionId  String @db.Uuid
  boqItemId      String? @db.Uuid
  itemCode       String
  description    String
  unit           String
  quantity       Decimal @db.Decimal(12, 4)
  estimatedPrice Decimal @db.Decimal(14, 2) @default(0)
  totalEstimated Decimal @db.Decimal(14, 2) @default(0)
  notes          String?
  createdAt      DateTime           @default(now())
  requisition    ProjectRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
  @@index([boqItemId])
}

model Quotation {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  quoteNumber    String             @unique
  requisitionId  String @db.Uuid
  vendorId       String @db.Uuid
  vendorName     String
  quoteDate      DateTime           @default(now())
  validUntil     DateTime?
  totalAmount    Decimal @db.Decimal(14, 2) @default(0)
  status         String             @default("PENDING")
  currency       String             @default("LKR")
  deliveryDays   Int?
  warrantyPeriod String?
  paymentTerms   String?
  remarks        String?
  acceptedById   String? @db.Uuid
  acceptedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  requisition    ProjectRequisition @relation("RequisitionQuotations", fields: [requisitionId], references: [id], onDelete: Cascade)
  vendor         Vendor             @relation(fields: [vendorId], references: [id])
  items          QuotationItem[]

  @@index([requisitionId])
  @@index([vendorId])
  @@index([status])
  @@index([quoteNumber])
  @@index([acceptedById])
}

model QuotationItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  quotationId  String @db.Uuid
  itemCode     String
  description  String
  unit         String
  quantity     Decimal @db.Decimal(12, 4)
  unitPrice    Decimal @db.Decimal(14, 2)
  totalPrice   Decimal @db.Decimal(14, 2)
  deliveryDays Int?
  notes        String?
  createdAt    DateTime  @default(now())
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model ProjectPurchaseOrder {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  poNumber           String                     @unique
  projectId          String @db.Uuid
  requisitionId      String? @db.Uuid
  vendorId           String @db.Uuid
  vendorName         String
  title              String
  description        String?
  status             String                     @default("DRAFT")
  priority           String                     @default("MEDIUM")
  type               String                     @default("MATERIAL")
  expenditureType    String                     @default("CAPEX") // CAPEX | OPEX
  orderDate          DateTime                   @default(now())
  expectedDelivery   DateTime?
  deliveryLocation   String?
  subtotal           Decimal @db.Decimal(14, 2) @default(0)
  taxAmount          Decimal @db.Decimal(14, 2) @default(0)
  discountAmount     Decimal @db.Decimal(14, 2) @default(0)
  totalAmount        Decimal @db.Decimal(14, 2) @default(0)
  currency           String                     @default("LKR")
  paymentTerms       String?
  deliveryTerms      String?
  notes              String?
  approvedById       String? @db.Uuid
  approvedAt         DateTime?
  issuedById         String? @db.Uuid
  issuedAt           DateTime?
  closedById         String? @db.Uuid
  closedAt           DateTime?
  cancellationReason String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  goodsReceipts      ProjectGoodsReceipt[]
  project            Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requisition        ProjectRequisition?        @relation(fields: [requisitionId], references: [id])
  items              ProjectPurchaseOrderItem[]

  @@index([projectId])
  @@index([requisitionId])
  @@index([vendorId])
  @@index([status])
  @@index([poNumber])
  @@index([approvedById])
  @@index([issuedById])
  @@index([closedById])
}

model ProjectPurchaseOrderItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  poId              String @db.Uuid
  requisitionItemId String? @db.Uuid
  itemCode          String
  description       String
  unit              String
  quantity          Decimal @db.Decimal(12, 4)
  unitPrice         Decimal @db.Decimal(14, 2)
  totalPrice        Decimal @db.Decimal(14, 2)
  receivedQty       Decimal @db.Decimal(14, 2) @default(0)
  balanceQty        Decimal @db.Decimal(14, 2) @default(0)
  deliveryDate      DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  purchaseOrder     ProjectPurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@index([poId])
  @@index([requisitionItemId])
}

model ProjectGoodsReceipt {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  grnNumber       String                    @unique
  poId            String @db.Uuid
  projectId       String @db.Uuid
  receivedById    String @db.Uuid
  receivedDate    DateTime                  @default(now())
  status          String                    @default("PENDING")
  deliveryNoteRef String?
  invoiceRef      String?
  remarks         String?
  storeId         String? @db.Uuid
  approvedById    String? @db.Uuid
  approvedAt      DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  purchaseOrder   ProjectPurchaseOrder      @relation(fields: [poId], references: [id], onDelete: Cascade)
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items           ProjectGoodsReceiptItem[]

  @@index([poId])
  @@index([projectId])
  @@index([grnNumber])
  @@index([status])
  @@index([receivedById])
  @@index([storeId])
  @@index([approvedById])
}

model ProjectGoodsReceiptItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  goodsReceiptId   String @db.Uuid
  poItemId         String @db.Uuid
  itemCode         String
  description      String
  unit             String
  quantityOrdered  Decimal @db.Decimal(14, 2)
  quantityReceived Decimal @db.Decimal(14, 2)
  quantityAccepted Decimal @db.Decimal(14, 2)
  quantityRejected Decimal @db.Decimal(14, 2) @default(0)
  rejectionReason  String?
  unitPrice        Decimal @db.Decimal(14, 2)
  totalPrice       Decimal @db.Decimal(14, 2)
  batchNumber      String?
  serialNumbers    String[]            @default([])
  notes            String?
  createdAt        DateTime            @default(now())
  goodsReceipt     ProjectGoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@index([goodsReceiptId])
  @@index([poItemId])
}

model ProjectInvoice {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceNumber    String               @unique
  projectId        String @db.Uuid
  title            String
  description      String?
  status           String               @default("DRAFT")
  type             String               @default("CLIENT")
  invoiceDate      DateTime             @default(now())
  dueDate          DateTime?
  subtotal         Decimal @db.Decimal(14, 2) @default(0)
  taxAmount        Decimal @db.Decimal(14, 2) @default(0)
  discountAmount   Decimal @db.Decimal(14, 2) @default(0)
  vatAmount        Decimal @db.Decimal(14, 2) @default(0)
  ssclAmount       Decimal @db.Decimal(14, 2) @default(0)
  whtAmount        Decimal @db.Decimal(14, 2) @default(0)
  vatPercent       Decimal @db.Decimal(8, 4) @default(18)
  ssclPercent      Decimal @db.Decimal(8, 4) @default(2.5)
  whtPercent       Decimal @db.Decimal(8, 4) @default(5)
  totalAmount      Decimal @db.Decimal(14, 2) @default(0)
  paidAmount       Decimal @db.Decimal(14, 2) @default(0)
  balanceAmount    Decimal @db.Decimal(14, 2) @default(0)
  currency         String               @default("LKR")
  notes            String?
  referenceNumber  String?
  periodFrom       DateTime?
  periodTo         DateTime?
  createdById      String? @db.Uuid
  approvedById     String? @db.Uuid
  approvedAt       DateTime?
  cancelledReason  String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  payments         PaymentVoucher[]     @relation("InvoicePayments")
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items            ProjectInvoiceItem[]
  retentions       ProjectRetention[]
  sods             ServiceOrder[]       @relation("ProjectInvoiceSODs")
  customerReceipts CustomerReceipt[]
  creditNotes      CreditDebitNote[]

  @@index([projectId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([invoiceDate])
  @@index([createdById])
  @@index([approvedById])
}

model ProjectInvoiceItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceId   String @db.Uuid
  description String
  quantity    Decimal @db.Decimal(12, 4) @default(1)
  unitPrice   Decimal @db.Decimal(14, 2) @default(0)
  totalPrice  Decimal @db.Decimal(14, 2) @default(0)
  boqItemId   String? @db.Uuid
  taskId      String? @db.Uuid
  itemType    String         @default("SERVICE")
  notes       String?
  createdAt   DateTime       @default(now())
  invoice     ProjectInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([boqItemId])
  @@index([taskId])
}

model PaymentVoucher {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  pvNumber           String          @unique
  projectId          String @db.Uuid
  title              String
  description        String?
  status             String          @default("DRAFT")
  type               String          @default("CONTRACTOR")
  expenditureType    String          @default("OPEX") // CAPEX | OPEX
  payeeName          String
  payeeId            String? @db.Uuid
  invoiceId          String? @db.Uuid
  amount             Decimal         @default(0)
  paymentDate        DateTime?
  paymentMethod      String?
  bankName           String?
  bankBranch         String?
  accountNumber      String?
  chequeNumber       String?
  referenceNumber    String?
  taxWithheld        Decimal         @default(0)
  netAmount          Decimal         @default(0)
  retentionAmount    Decimal         @default(0)
  retentionReleaseId String? @db.Uuid
  notes              String?
  createdById        String? @db.Uuid
  approvedById       String? @db.Uuid
  approvedAt         DateTime?
  paidById           String? @db.Uuid
  paidAt             DateTime?
  rejectionReason    String?
  cancelledReason    String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  invoice            ProjectInvoice? @relation("InvoicePayments", fields: [invoiceId], references: [id])
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([pvNumber])
  @@index([invoiceId])
  @@index([payeeId])
  @@index([retentionReleaseId])
  @@index([createdById])
  @@index([approvedById])
  @@index([paidById])
}

model ProjectLDPenalty {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId      String @db.Uuid
  title          String
  description    String?
  type           String    @default("LD")
  category       String    @default("DELAY")
  amount         Decimal @db.Decimal(14, 2) @default(0)
  percentage     Decimal? @db.Decimal(14, 2)
  referenceTable String?
  referenceId    String? @db.Uuid
  referenceDesc  String?
  waivedAmount   Decimal @db.Decimal(14, 2) @default(0)
  netAmount      Decimal @db.Decimal(14, 2) @default(0)
  status         String    @default("PROPOSED")
  appliedDate    DateTime?
  leviedById     String? @db.Uuid
  approvedById   String? @db.Uuid
  approvedAt     DateTime?
  remarks        String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([referenceId])
  @@index([leviedById])
  @@index([approvedById])
}

model ProjectRetention {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId             String @db.Uuid
  invoiceId             String? @db.Uuid
  title                 String
  description           String?
  retentionPercent      Decimal @db.Decimal(8, 4) @default(10)
  retentionAmount       Decimal @db.Decimal(14, 2) @default(0)
  releasedAmount        Decimal @db.Decimal(14, 2) @default(0)
  balanceAmount         Decimal @db.Decimal(14, 2) @default(0)
  status                String             @default("HELD")
  releaseCondition      String?
  defectLiabilityPeriod Int?
  defectLiabilityEnd    DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  invoice               ProjectInvoice?    @relation(fields: [invoiceId], references: [id])
  project               Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  releases              RetentionRelease[]

  @@index([projectId])
  @@index([status])
  @@index([invoiceId])
}

model RetentionRelease {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  retentionId      String @db.Uuid
  releaseAmount    Decimal @db.Decimal(14, 2) @default(0)
  releaseDate      DateTime         @default(now())
  paymentVoucherId String? @db.Uuid
  approvedById     String? @db.Uuid
  approvedAt       DateTime?
  remarks          String?
  createdAt        DateTime         @default(now())
  retention        ProjectRetention @relation(fields: [retentionId], references: [id], onDelete: Cascade)

  @@index([retentionId])
  @@index([paymentVoucherId])
  @@index([approvedById])
}

model ProjectChangeOrder {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  coNumber        String    @unique
  projectId       String @db.Uuid
  title           String
  description     String?
  type            String    @default("SCOPE")
  status          String    @default("DRAFT")
  priority        String    @default("MEDIUM")
  reason          String?
  referenceTable  String?
  referenceId     String? @db.Uuid
  originalValue   Decimal? @db.Decimal(14, 2)
  newValue        Decimal? @db.Decimal(14, 2)
  costImpact      Decimal @db.Decimal(14, 2) @default(0)
  timeImpact      Int?
  scopeImpact     String?
  riskAssessment  String?
  supportingDocs  String[]  @default([])
  requestedById   String? @db.Uuid
  requestedDate   DateTime  @default(now())
  approvedById    String? @db.Uuid
  approvedAt      DateTime?
  rejectionReason String?
  implementedById String? @db.Uuid
  implementedAt   DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([coNumber])
  @@index([type])
  @@index([referenceId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([implementedById])
}

model ProjectPayment {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId     String @db.Uuid
  paymentNumber String    @unique
  amount        Decimal @db.Decimal(14, 2)
  description   String?
  invoiceRef    String?
  level1Status  String    @default("PENDING")
  level1UserId  String? @db.Uuid
  level1At      DateTime?
  level1Notes   String?
  level2Status  String    @default("PENDING")
  level2UserId  String? @db.Uuid
  level2At      DateTime?
  level2Notes   String?
  level3Status  String    @default("PENDING")
  level3UserId  String? @db.Uuid
  level3At      DateTime?
  level3Notes   String?
  status        String    @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([paymentNumber])
  @@index([level1UserId])
  @@index([level2UserId])
  @@index([level3UserId])
}

model CostAllocationMemo {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  memoNumber       String                   @unique
  title            String
  description      String?
  totalCost        Decimal @db.Decimal(14, 2) @default(0)
  journalEntryId   String? @db.Uuid
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  allocationTarget String?
  approvedAt       DateTime?
  documentUrl      String?
  receivedAt       DateTime?
  items            CostAllocationMemoItem[]

  @@index([memoNumber])
  @@index([journalEntryId])
}

model CostAllocationMemoItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  memoId    String @db.Uuid
  itemName  String
  quantity  Int                @default(1)
  unitCost  Decimal @db.Decimal(14, 2) @default(0)
  totalCost Decimal @db.Decimal(14, 2) @default(0)
  memo      CostAllocationMemo @relation(fields: [memoId], references: [id], onDelete: Cascade)

  @@index([memoId])
}
