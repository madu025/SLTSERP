model ServiceOrder {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  rtom               String
  lea                String?
  soNum              String                      @unique
  voiceNumber        String?
  orderType          String?
  serviceType        String?
  customerName       String?
  techContact        String?
  status             ServiceOrderStatus
  statusDate         DateTime?
  receivedDate       DateTime?
  address            String?
  dp                 String?
  package            String?
  ospPhoneClass      String?
  phonePurchase      String?
  sales              String?
  woroTaskName       String?
  iptv               String?
  woroSeit           String?
  ftthInstSeit       String?
  ftthWifi           String?
  sltsStatus         ServiceOrderStatus          @default(INPROGRESS)
  scheduledDate      DateTime?
  scheduledTime      String?
  comments           String?
  completedDate      DateTime?
  ontSerialNumber    String?
  dpDetails          String?
  patStatus          String?
  sltsPatStatus      PatStatusEnum?              @default(PENDING)
  sltsPatDate        DateTime?
  opmcPatStatus      PatStatusEnum?              @default(PENDING)
  opmcPatDate        DateTime?
  hoPatStatus        PatStatusEnum?              @default(PENDING)
  hoPatDate          DateTime?
  isInvoicable       Boolean                     @default(false)
  invoiced           Boolean                     @default(false)
  invoiceId          String? @db.Uuid
  wiredOnly          Boolean                     @default(false)
  delayReasonsRaw    Json?                       @map("delayReasons")
  delayReasons       ServiceOrderDelayReason[]
  stbShortage        Boolean                     @default(false)
  ontShortage        Boolean                     @default(false)
  ontType            String?
  returnReason       String?
  completionMode     String?
  materialSource     String?
  directTeam         String?
  photoUrls          String[]                    @default([])
  dropWireDistance   Decimal?                    @db.Decimal(10, 2)
  revenueAmount      Decimal?                    @db.Decimal(14, 2)
  contractorAmount   Decimal?                    @db.Decimal(14, 2)

  opmcId             String @db.Uuid
  contractorId       String? @db.Uuid
  teamId             String? @db.Uuid
  isManualEntry      Boolean                     @default(false)
  isLegacyImport     Boolean                     @default(false)
  isOfflineWorkOrder Boolean                     @default(false)
  offlineReference   String?
  qcStatus           String?                     @default("PENDING_QC")
  qcDefects          Json?
  qcComment          String?
  qcInspectedAt      DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  projectInvoiceId   String? @db.Uuid
  collectedCPEs      CollectedCPE[]              @relation("CollectedCPEs")
  materialReturns    ContractorMaterialReturn[]  @relation("SODMaterialReturns")
  penalties          Penalty[]
  restoreRequests    RestoreRequest[]
  erectedPoles       SODErectedPole[]
  forensicAudit      SODForensicAudit?
  iptvSerials        SODIptvSerial[]
  materialUsage      SODMaterialUsage[]
  contractor         Contractor?                 @relation(fields: [contractorId], references: [id])
  invoice            Invoice?                    @relation(fields: [invoiceId], references: [id])
  opmc               OPMC                        @relation(fields: [opmcId], references: [id], onDelete: Cascade)
  projectInvoice     ProjectInvoice?             @relation("ProjectInvoiceSODs", fields: [projectInvoiceId], references: [id])
  team               ContractorTeam?             @relation(fields: [teamId], references: [id])
  commentsHistory    ServiceOrderComment[]
  statusHistory      ServiceOrderStatusHistory[]

  @@index([opmcId])
  @@index([rtom])
  @@index([status])
  @@index([soNum])
  @@index([scheduledDate])
  @@index([contractorId])
  @@index([projectInvoiceId])
  @@index([teamId])
  @@index([sltsStatus])
  @@index([createdAt])
  @@index([completedDate])
  @@index([updatedAt])
  @@index([opmcId, status])
  @@index([opmcId, sltsStatus])
  @@index([receivedDate])
  @@index([statusDate])
  @@index([isInvoicable])
  @@index([directTeam])
  @@index([woroTaskName])
  @@index([isOfflineWorkOrder])
  @@index([opmcId, isOfflineWorkOrder])
  @@index([invoiceId])
  @@index([status, sltsStatus, receivedDate])
}

model SODForensicAudit {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  soNum           String       @unique
  auditData       Json
  voiceTestStatus String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  serviceOrder    ServiceOrder @relation(fields: [soNum], references: [soNum], onDelete: Cascade)

  @@index([soNum])
}

model ExtensionRawData {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  soNum       String?
  sltUser     String?
  activeTab   String?
  url         String?
  scrapedData Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([soNum])
  @@index([updatedAt])
}

model ServiceOrderStatusHistory {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceOrderId String @db.Uuid
  status         ServiceOrderStatus
  statusDate     DateTime
  createdAt      DateTime           @default(now())
  serviceOrder   ServiceOrder       @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([statusDate])
  @@index([status])
  // Duplicate-suppression reads the newest row for a SOD on every status write.
  @@index([serviceOrderId, createdAt])
}

model ServiceOrderComment {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceOrderId String @db.Uuid
  comment        String
  authorId       String? @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  author         User?        @relation("UserComments", fields: [authorId], references: [id])
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([createdAt])
  @@index([authorId])
}

model RestoreRequest {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceOrderId  String @db.Uuid
  requestedById   String @db.Uuid
  reason          String
  status          String       @default("PENDING")
  approvedById    String? @db.Uuid
  approvalComment String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  approvedBy      User?        @relation("ApprovedRestores", fields: [approvedById], references: [id])
  requestedBy     User         @relation("RequestedRestores", fields: [requestedById], references: [id])
  serviceOrder    ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([serviceOrderId])
  @@index([requestedById])
  @@index([approvedById])
}

model SODMaterialUsage {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceOrderId String @db.Uuid
  itemId         String @db.Uuid
  quantity       Decimal @db.Decimal(12, 4)
  unit           String
  usageType      String
  batchId        String? @db.Uuid
  unitPrice      Decimal? @db.Decimal(14, 2) @default(0)
  costPrice      Decimal? @db.Decimal(14, 2) @default(0)
  wastagePercent Decimal? @db.Decimal(8, 4)
  exceedsLimit   Boolean              @default(false)
  comment        String?
  serialNumber   String?
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime             @default(now())
  batch          InventoryBatch?      @relation(fields: [batchId], references: [id])
  item           InventoryItem        @relation("SODUsage", fields: [itemId], references: [id])
  serviceOrder   ServiceOrder         @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  serialItem     InventoryItemSerial? @relation(fields: [serialNumber], references: [serialNumber], onDelete: SetNull)

  @@index([serviceOrderId])
  @@index([itemId])
  @@index([usageType])
  @@index([serialNumber])
  @@index([batchId])
}

model SODRevenueConfig {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  rtomId        String? @db.Uuid
  revenuePerSOD Decimal @db.Decimal(14, 2)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  circularRef   String?
  notes         String?
  isActive      Boolean   @default(true)
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  rtom          OPMC?     @relation(fields: [rtomId], references: [id], onDelete: Cascade)

  @@index([rtomId])
  @@index([effectiveFrom, effectiveTo])
  @@index([isActive])
}

model SLTPATStatus {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  soNum        String    @unique
  rtom         String?
  lea          String?
  voiceNumber  String?
  sType        String?
  orderType    String?
  task         String?
  package      String?
  conName      String?
  patUser      String?
  status       String
  source       String
  statusDate   DateTime?
  updatedAt    DateTime  @updatedAt
  hasDuplicate Boolean   @default(false)

  @@index([status])
  @@index([rtom])
  @@index([soNum])
}

model PATSession {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId       String @db.Uuid
  patType         String
  status          String           @default("PENDING")
  sltOfficers     Json?
  fineTuneNeeded  Boolean          @default(false)
  fineTuneDetails Json?
  totalPoints     Int              @default(0)
  passedPoints    Int              @default(0)
  failedPoints    Int              @default(0)
  passRate        Decimal? @db.Decimal(8, 4)
  conductedById   String? @db.Uuid
  conductedAt     DateTime?
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  pointResults    PATPointResult[]
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([patType])
  @@index([status])
  @@index([conductedById])
}

model PATPointResult {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  patSessionId   String @db.Uuid
  pointReference String
  measuredPower  Decimal? @db.Decimal(12, 4)
  acceptedPower  Decimal? @db.Decimal(12, 4)
  powerStatus    String?    @default("PENDING")
  verifiedLat    Decimal? @db.Decimal(11, 8)
  verifiedLng    Decimal? @db.Decimal(11, 8)
  fineTuneNeeded Boolean    @default(false)
  fineTuneType   String?
  fineTuneNotes  String?
  photoUrls      String[]   @default([])
  createdAt      DateTime   @default(now())
  patSession     PATSession @relation(fields: [patSessionId], references: [id], onDelete: Cascade)

  @@index([patSessionId])
  @@index([powerStatus])
}

model CollectedCPE {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceOrderId    String @db.Uuid
  contractorId      String @db.Uuid
  deviceType        String
  serialNumber      String
  condition         String       @default("FAULTY")
  status            String       @default("PENDING_HANDBACK")
  collectedDate     DateTime     @default(now())
  handbackDate      DateTime?
  handbackReference String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  contractor        Contractor   @relation("CollectedCPEs", fields: [contractorId], references: [id], onDelete: Cascade)
  serviceOrder      ServiceOrder @relation("CollectedCPEs", fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
  @@index([contractorId])
  @@index([status])
}

model SODErectedPole {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceOrderId String @db.Uuid
  poleType       String
  poleNumber     String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
}

model SODIptvSerial {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceOrderId String @db.Uuid
  serialNumber   String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  serviceOrder   ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@index([serviceOrderId])
}

model ServiceOrderDelayReason {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  serviceOrderId String @db.Uuid
  reason         String
  createdAt      DateTime @default(now())

  serviceOrder ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)

  @@unique([serviceOrderId, reason])
  @@index([serviceOrderId])
}
