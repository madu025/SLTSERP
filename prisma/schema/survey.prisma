/// Polymorphic Assignment:
/// - assignedToId: Staff.id (individual surveyor)
/// - assignedTeamId: ContractorTeam.id (field team)
/// Both are raw strings (no FK relations) to support polymorphic assignment.
/// Use assignee lookup endpoints: GET /api/staff, GET /api/contractors/teams
model SurveyRequest {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId      String @db.Uuid
  requestNumber  String          @unique
  title          String
  description    String?
  surveyType     String
  priority       String          @default("MEDIUM")
  status         String          @default("PENDING")
  assignedTeamId String? @db.Uuid
  assignedToId   String? @db.Uuid
  scheduledDate  DateTime?
  completedDate  DateTime?
  estimatedBOQ   Decimal? @db.Decimal(14, 2)
  finalBOQ       Decimal? @db.Decimal(14, 2)
  remarks        String?
  createdById    String @db.Uuid
  approvedById   String? @db.Uuid
  approvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  checkins       SurveyCheckIn[]
  findings       SurveyFinding[]
  photos         SurveyPhoto[]
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([requestNumber])
  @@index([assignedTeamId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([approvedById])
}

model SurveyCheckIn {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  surveyRequestId String @db.Uuid
  checkInType     String
  timestamp       DateTime      @default(now())
  latitude        Decimal? @db.Decimal(11, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  address         String?
  userId          String @db.Uuid
  remarks         String?
  surveyRequest   SurveyRequest @relation(fields: [surveyRequestId], references: [id], onDelete: Cascade)

  @@index([surveyRequestId])
  @@index([userId])
}

model SurveyPhoto {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  surveyRequestId String @db.Uuid
  fileName        String
  fileUrl         String
  latitude        Decimal? @db.Decimal(11, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  altitude        Decimal? @db.Decimal(11, 8)
  bearing         Decimal? @db.Decimal(11, 8)
  photoType       String
  description     String?
  uploadedById    String @db.Uuid
  uploadedAt      DateTime      @default(now())
  surveyRequest   SurveyRequest @relation(fields: [surveyRequestId], references: [id], onDelete: Cascade)

  @@index([surveyRequestId])
  @@index([uploadedById])
}

model SurveyFinding {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  surveyRequestId String @db.Uuid
  findingType     String
  description     String
  severity        String        @default("MEDIUM")
  latitude        Decimal? @db.Decimal(11, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  recommendation  String?
  status          String        @default("OPEN")
  resolvedAt      DateTime?
  resolvedById    String? @db.Uuid
  photoId         String? @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  surveyRequest   SurveyRequest @relation(fields: [surveyRequestId], references: [id], onDelete: Cascade)

  @@index([surveyRequestId])
  @@index([findingType])
  @@index([resolvedById])
  @@index([photoId])
}

model FieldTask {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId       String @db.Uuid
  taskInstanceId  String? @db.Uuid
  assignedTeamId  String? @db.Uuid
  assignedUserId  String? @db.Uuid
  title           String
  description     String?
  status          String           @default("ASSIGNED")
  priority        String           @default("MEDIUM")
  scheduledDate   DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMinutes Int?
  latitude        Decimal? @db.Decimal(11, 8)
  longitude       Decimal? @db.Decimal(11, 8)
  address         String?
  syncStatus      String           @default("PENDING")
  deviceId        String? @db.Uuid
  appVersion      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  checklists      FieldChecklist[]
  photos          FieldPhoto[]
  signatures      FieldSignature[]
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([assignedUserId])
  @@index([syncStatus])
  @@index([taskInstanceId])
  @@index([assignedTeamId])
  @@index([deviceId])
}

model FieldPhoto {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  fieldTaskId String @db.Uuid
  fileName    String
  fileUrl     String
  photoType   String
  latitude    Decimal? @db.Decimal(11, 8)
  longitude   Decimal? @db.Decimal(11, 8)
  uploadedAt  DateTime  @default(now())
  fieldTask   FieldTask @relation(fields: [fieldTaskId], references: [id], onDelete: Cascade)

  @@index([fieldTaskId])
}

model FieldChecklist {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  fieldTaskId   String @db.Uuid
  label         String
  isMandatory   Boolean   @default(true)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  photoRequired Boolean   @default(false)
  photoUrl      String?
  fieldTask     FieldTask @relation(fields: [fieldTaskId], references: [id], onDelete: Cascade)

  @@index([fieldTaskId])
}

model FieldSignature {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  fieldTaskId      String @db.Uuid
  signatoryName    String
  signatureDataUrl String
  role             String?
  signedAt         DateTime  @default(now())
  fieldTask        FieldTask @relation(fields: [fieldTaskId], references: [id], onDelete: Cascade)

  @@index([fieldTaskId])
}

model OTDRTest {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId       String @db.Uuid
  cableSegmentId  String? @db.Uuid
  testNumber      String           @unique
  testDate        DateTime         @default(now())
  testType        String
  fiberNumber     Int?
  wavelength      Int?
  traceFileName   String?
  traceFileUrl    String?
  fileFormat      String?
  totalLength     Decimal? @db.Decimal(12, 4)
  endToEndLoss    Decimal? @db.Decimal(12, 4)
  lossPerKm       Decimal? @db.Decimal(12, 4)
  orl             Decimal? @db.Decimal(12, 4)
  spliceLoss      Decimal? @db.Decimal(12, 4)
  connectorLoss   Decimal? @db.Decimal(12, 4)
  spliceCount     Int?
  eventCount      Int?
  lossLimit       Decimal? @db.Decimal(12, 4)
  orlLimit        Decimal? @db.Decimal(12, 4)
  autoResult      String?
  failureReason   String?
  testedById      String @db.Uuid
  equipmentModel  String?
  equipmentSerial String?
  remarks         String?
  status          String           @default("PENDING_REVIEW")
  reviewedById    String? @db.Uuid
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cableSegment    GISCableSegment? @relation("CableSegmentOTDR", fields: [cableSegmentId], references: [id])
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events          OTDRTestEvent[]

  @@index([projectId])
  @@index([testNumber])
  @@index([autoResult])
  @@index([cableSegmentId])
  @@index([testedById])
  @@index([reviewedById])
}

model OTDRTestEvent {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  testId         String @db.Uuid
  eventNumber    Int
  eventType      String
  distance       Decimal @db.Decimal(14, 2)
  loss           Decimal? @db.Decimal(12, 4)
  reflectance    Decimal? @db.Decimal(12, 4)
  cumulativeLoss Decimal? @db.Decimal(12, 4)
  comment        String?
  test           OTDRTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([eventNumber])
}

model HSESafetyLog {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId        String @db.Uuid
  logType          String
  title            String
  description      String?
  location         String?
  date             DateTime      @default(now())
  severity         String?
  status           String        @default("OPEN")
  topic            String?
  presenterName    String?
  attendeeCount    Int?
  durationMinutes  Int?
  incidentType     String?
  injuryCount      Int?          @default(0)
  fatalityCount    Int?          @default(0)
  propertyDamage   Decimal? @db.Decimal(12, 4)
  rootCause        String?
  correctiveAction String?
  ppeChecklist     Json?
  allCompliant     Boolean?      @default(false)
  photoUrls        String[]      @default([])
  documentUrls     String[]      @default([])
  recordedById     String @db.Uuid
  closedById       String? @db.Uuid
  closedAt         DateTime?
  blocksStage      Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attendees        HSEAttendee[]
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([logType])
  @@index([date])
  @@index([status])
  @@index([severity])
  @@index([recordedById])
  @@index([closedById])
}

model HSEAttendee {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  safetyLogId  String @db.Uuid
  name         String
  designation  String?
  signatureUrl String?
  attendedAt   DateTime     @default(now())
  safetyLog    HSESafetyLog @relation(fields: [safetyLogId], references: [id], onDelete: Cascade)

  @@index([safetyLogId])
}
