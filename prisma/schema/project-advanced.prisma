model ProjectRisk {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId      String @db.Uuid
  title          String
  description    String
  probability    Int
  impact         Int
  score          Int
  mitigationPlan String?
  status         String   @default("OPEN")
  identifiedById String @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([identifiedById])
}

model ProjectInspection {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId        String @db.Uuid
  title            String
  category         String
  status           String    @default("PENDING")
  checklist        Json
  correctiveAction String?
  photoUrls        String[]  @default([])
  inspectorId      String @db.Uuid
  inspectedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([inspectorId])
}

model ProjectEVM {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId            String @db.Uuid        @unique
  lastCalculatedAt     DateTime      @default(now())
  pvTotal              Decimal @db.Decimal(14, 2) @default(0)
  pvCurrentPeriod      Decimal @db.Decimal(14, 2) @default(0)
  evTotal              Decimal @db.Decimal(14, 2) @default(0)
  evCurrentPeriod      Decimal @db.Decimal(14, 2) @default(0)
  acTotal              Decimal @db.Decimal(14, 2) @default(0)
  acCurrentPeriod      Decimal @db.Decimal(14, 2) @default(0)
  spi                  Decimal? @db.Decimal(8, 4)
  cpi                  Decimal? @db.Decimal(8, 4)
  scheduleVariance     Decimal? @db.Decimal(14, 2)
  costVariance         Decimal? @db.Decimal(14, 2)
  estimateAtCompletion Decimal? @db.Decimal(14, 2)
  estimateToComplete   Decimal? @db.Decimal(14, 2)
  varianceAtCompletion Decimal? @db.Decimal(14, 2)
  status               String        @default("GREEN")
  statusNotes          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  snapshots            EVMSnapshot[]
  project              Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model EVMSnapshot {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  evmId            String @db.Uuid
  snapshotDate     DateTime   @default(now())
  pvCumulative     Decimal @db.Decimal(14, 2) @default(0)
  evCumulative     Decimal @db.Decimal(14, 2) @default(0)
  acCumulative     Decimal @db.Decimal(14, 2) @default(0)
  spi              Decimal? @db.Decimal(8, 4)
  cpi              Decimal? @db.Decimal(8, 4)
  scheduleVariance Decimal? @db.Decimal(14, 2)
  costVariance     Decimal? @db.Decimal(14, 2)
  periodLabel      String
  createdAt        DateTime   @default(now())
  evm              ProjectEVM @relation(fields: [evmId], references: [id], onDelete: Cascade)

  @@index([evmId])
  @@index([snapshotDate])
}

model ProjectAsset {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId         String @db.Uuid
  assetType         String
  assetCode         String?
  assetName         String
  description       String?
  latitude          Decimal? @db.Decimal(11, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  address           String?
  routeIdentifier   String?
  fiberCount        Int?
  cableType         String?
  manufacturer      String?
  model             String?
  serialNumber      String?
  status            String                   @default("ACTIVE")
  ownership         String?
  warrantyExpiry    DateTime?
  installationDate  DateTime?
  commissionedDate  DateTime?
  sourceType        String?
  sourceId          String? @db.Uuid
  sourceDescription String?
  transferredToNOC  Boolean                  @default(false)
  transferDate      DateTime?
  nocAssetId        String? @db.Uuid
  transferNotes     String?
  createdById       String @db.Uuid
  verifiedById      String? @db.Uuid
  verifiedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  project           Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cables            ProjectAssetCable[]
  connections       ProjectAssetConnection[] @relation("AssetConnections")
  connectedFrom     ProjectAssetConnection[] @relation("ConnectedAssets")
  documents         ProjectAssetDocument[]

  @@index([projectId])
  @@index([assetType])
  @@index([assetCode])
  @@index([status])
  @@index([transferredToNOC])
  @@index([sourceId])
  @@index([nocAssetId])
  @@index([createdById])
  @@index([verifiedById])
}

model ProjectAssetCable {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assetId            String @db.Uuid
  cableNumber        Int
  fiberCount         Int
  fiberFrom          Int?
  fiberTo            Int?
  direction          String?
  connectedToAssetId String? @db.Uuid
  connectedToPort    String?
  notes              String?
  createdAt          DateTime     @default(now())
  asset              ProjectAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([connectedToAssetId])
}

model ProjectAssetConnection {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assetId          String @db.Uuid
  connectedAssetId String @db.Uuid
  connectionType   String
  fiberNumber      Int?
  loss             Decimal? @db.Decimal(12, 4)
  testReferenceId  String? @db.Uuid
  notes            String?
  createdAt        DateTime     @default(now())
  asset            ProjectAsset @relation("AssetConnections", fields: [assetId], references: [id], onDelete: Cascade)
  connectedAsset   ProjectAsset @relation("ConnectedAssets", fields: [connectedAssetId], references: [id])

  @@index([assetId])
  @@index([connectedAssetId])
  @@index([testReferenceId])
}

model ProjectAssetDocument {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  assetId      String @db.Uuid
  documentType String
  fileName     String
  fileUrl      String
  uploadedById String @db.Uuid
  uploadedAt   DateTime     @default(now())
  asset        ProjectAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([uploadedById])
}

model ProjectChangeRequest {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId       String @db.Uuid
  requestNumber   String           @unique
  changeType      String
  title           String
  description     String?
  costImpact      Decimal? @db.Decimal(14, 2)
  timeImpact      Int?
  routeChangeData Json?
  status          String           @default("DRAFT")
  requestedById   String? @db.Uuid
  submittedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  approvals       ChangeApproval[]
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([requestNumber])
  @@index([requestedById])
}

model ChangeApproval {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  changeRequestId String @db.Uuid
  stepOrder       Int                  @default(1)
  role            String
  status          String               @default("PENDING")
  approverId      String? @db.Uuid
  approvedById    String? @db.Uuid
  approvedAt      DateTime?
  remarks         String?
  comment         String?
  createdAt       DateTime             @default(now())
  changeRequest   ProjectChangeRequest @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)

  @@index([changeRequestId])
  @@index([status])
  @@index([approverId])
  @@index([approvedById])
}

model AiPrediction {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId       String? @db.Uuid
  predictionType  String
  riskLevel       String
  probabilityPct  Decimal @db.Decimal(8, 4)
  predictedImpact String
  currentMetrics  Json
  rootCause       String?
  recommendation  String?
  confidenceScore Decimal? @db.Decimal(8, 4)
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  project         Project?  @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([predictionType])
  @@index([riskLevel])
  @@index([isResolved])
}
