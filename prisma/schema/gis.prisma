model GISRoute {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId       String @db.Uuid
  name            String
  description     String?
  sourceFile      String?
  sourceFormat    String?
  routeLength     Decimal? @db.Decimal(12, 4)
  poleSpacing     Decimal? @db.Decimal(12, 4)
  calculatedPoles Int?
  status          String            @default("DRAFT")
  geojsonData     Json?
  metadata        Json?
  createdById     String? @db.Uuid
  approvedById    String? @db.Uuid
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  version         Int               @default(1)
  parentVersionId String? @db.Uuid
  childVersionId  String? @db.Uuid
  versionType     String            @default("PLANNED")
  changeRequestId String? @db.Uuid
  isActive        Boolean           @default(true)
  polygonData     Json?
  osmData         Json?
  cableSegments   GISCableSegment[]
  chambers        GISChamber[]
  closures        GISClosure[]
  generatedBOQs   GISGeneratedBOQ[]
  poles           GISPole[]
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([versionType])
  @@index([isActive])
  @@index([createdById])
  @@index([approvedById])
  @@index([parentVersionId])
  @@index([childVersionId])
  @@index([changeRequestId])
}

model GISPole {
  properties       Json?
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  routeId          String @db.Uuid
  poleNumber       Int
  latitude         Decimal @db.Decimal(11, 8)
  longitude        Decimal @db.Decimal(11, 8)
  elevation        Decimal? @db.Decimal(11, 8)
  poleType         String?
  height           Decimal? @db.Decimal(12, 4)
  status           String            @default("PLANNED")
  installationDate DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  outgoingSegments GISCableSegment[] @relation("SegmentFromPole")
  incomingSegments GISCableSegment[] @relation("SegmentToPole")
  route            GISRoute          @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
  @@index([poleNumber])
}

model GISChamber {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  routeId          String @db.Uuid
  chamberNumber    Int
  chamberType      String?
  latitude         Decimal @db.Decimal(11, 8)
  longitude        Decimal @db.Decimal(11, 8)
  depth            Decimal? @db.Decimal(12, 4)
  dimensions       String?
  status           String            @default("PLANNED")
  installationDate DateTime?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  outgoingSegments GISCableSegment[] @relation("SegmentFromChamber")
  incomingSegments GISCableSegment[] @relation("SegmentToChamber")
  route            GISRoute          @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

model GISClosure {
  properties       Json?
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  routeId          String @db.Uuid
  closureNumber    Int
  closureType      String?
  latitude         Decimal @db.Decimal(11, 8)
  longitude        Decimal @db.Decimal(11, 8)
  capacity         Int?
  status           String    @default("PLANNED")
  installationDate DateTime?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  route            GISRoute  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

model GISCableSegment {
  properties         Json?
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  routeId            String @db.Uuid
  segmentNumber      Int
  fromPoleId         String? @db.Uuid
  toPoleId           String? @db.Uuid
  fromChamberId      String? @db.Uuid
  toChamberId        String? @db.Uuid
  length             Decimal @db.Decimal(12, 4)
  cableType          String?
  fiberCount         Int?
  ductCount          Int?
  installationMethod String?
  status             String      @default("PLANNED")
  notes              String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  fromChamber        GISChamber? @relation("SegmentFromChamber", fields: [fromChamberId], references: [id])
  fromPole           GISPole?    @relation("SegmentFromPole", fields: [fromPoleId], references: [id])
  route              GISRoute    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  toChamber          GISChamber? @relation("SegmentToChamber", fields: [toChamberId], references: [id])
  toPole             GISPole?    @relation("SegmentToPole", fields: [toPoleId], references: [id])
  otdrTests          OTDRTest[]  @relation("CableSegmentOTDR")

  @@index([routeId])
  @@index([segmentNumber])
  @@index([fromPoleId])
  @@index([toPoleId])
  @@index([fromChamberId])
  @@index([toChamberId])
}

model GISGeneratedBOQ {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  routeId        String @db.Uuid
  projectId      String @db.Uuid
  status         String                @default("DRAFT")
  totalEstimated Decimal @db.Decimal(14, 2) @default(0)
  notes          String?
  createdById    String? @db.Uuid
  approvedById   String? @db.Uuid
  approvedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  route          GISRoute              @relation(fields: [routeId], references: [id], onDelete: Cascade)
  items          GISGeneratedBOQItem[]

  @@index([routeId])
  @@index([projectId])
  @@index([status])
  @@index([createdById])
  @@index([approvedById])
}

model GISGeneratedBOQItem {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  boqId           String @db.Uuid
  itemCategory    String
  itemCode        String
  description     String
  unit            String
  quantity        Decimal @db.Decimal(12, 4)
  unitRate        Decimal @db.Decimal(12, 4) @default(0)
  amount          Decimal @db.Decimal(14, 2) @default(0)
  sourceType      String?
  sourceReference String?
  remarks         String?
  createdAt       DateTime        @default(now())
  generatedBOQ    GISGeneratedBOQ @relation(fields: [boqId], references: [id], onDelete: Cascade)

  @@index([boqId])
}

model QFieldCloudSyncLog {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId     String @db.Uuid
  syncType      String
  status        String
  featuresCount Int       @default(0)
  errorMessage  String?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([projectId])
  @@index([status])
}

model MobileSurveySession {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId    String @db.Uuid
  supervisorId String @db.Uuid
  status       String        @default("IN_PROGRESS")
  pointsCount  Int           @default(0)
  syncStatus   String        @default("PENDING")
  notes        String?
  startedAt    DateTime      @default(now())
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  surveyPoints SurveyPoint[]

  @@index([projectId])
  @@index([supervisorId])
  @@index([status])
}

model SurveyPoint {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  sessionId          String @db.Uuid
  projectId          String @db.Uuid
  layerId            String @db.Uuid
  layerName          String
  latitude           Decimal @db.Decimal(11, 8)
  longitude          Decimal @db.Decimal(11, 8)
  attributes         Json
  photoUrls          String[]            @default([])
  supervisorId       String? @db.Uuid
  verificationStatus String              @default("PENDING_VERIFICATION")
  verificationStep   String              @default("SUPERVISOR")
  verifiedById       String? @db.Uuid
  verifiedAt         DateTime?
  approvedById       String? @db.Uuid
  approvedAt         DateTime?
  rejectionReason    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session            MobileSurveySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([projectId])
  @@index([layerId])
  @@index([verificationStatus])
  @@index([supervisorId])
  @@index([verifiedById])
  @@index([approvedById])
}

model GISAuditLog {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId      String @db.Uuid
  entityType     String
  entityId       String // free-form: entity ids are UUIDs but kept text for resilience
  action         String
  fieldChanges   Json?
  locationBefore Json?
  locationAfter  Json?
  performedById  String? @db.Uuid // nullable: 'SYSTEM'/cron actors store null
  performedAt    DateTime @default(now())
  routeVersion   Int?
  source         String   @default("WEB_PORTAL")
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([entityType, entityId])
  @@index([performedAt])
  @@index([performedById])
}

model QFieldFieldConfig {
  id String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  projectId String @db.Uuid
  layerId   String @db.Uuid
  fieldName String
  options   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, layerId, fieldName])
  @@index([projectId])
  @@index([layerId])
}

model GISRoadData {
  fid        Int      @id
  wkt        String
  wayFbid    String?
  highwayTag String?
  createdAt  DateTime @default(now())
  maxLat     Decimal? @db.Decimal(11, 8)
  maxLon     Decimal? @db.Decimal(11, 8)
  minLat     Decimal? @db.Decimal(11, 8)
  minLon     Decimal? @db.Decimal(11, 8)
}
