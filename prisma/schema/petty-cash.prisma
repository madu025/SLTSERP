model PettyCashAccount {
  id             String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name           String
  /// the site office (an InventoryStore) that keeps this box; null only for boxes made before site offices
  siteOfficeId   String?                  @unique @db.Uuid
  opmcId         String?                  @db.Uuid
  imprestLimit   Decimal                  @default(0) @db.Decimal(14, 2)
  currentBalance Decimal                  @default(0) @db.Decimal(14, 2)
  status         String                   @default("ACTIVE")
  createdById    String?                  @db.Uuid
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  opmc           OPMC?                    @relation(fields: [opmcId], references: [id], onDelete: Cascade)
  reimbursements PettyCashReimbursement[]
  vouchers       PettyCashVoucher[]

  @@index([opmcId])
  @@index([createdById])
}

model PettyCashVoucher {
  id              String                  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId       String                  @db.Uuid
  voucherNumber   String                  @unique
  date            DateTime                @default(now())
  title           String
  description     String?
  amount          Decimal                 @default(0) @db.Decimal(14, 2)
  category        String
  status          String                  @default("DRAFT")
  recipientName   String?
  receiptUrl      String?
  approvedById    String?                 @db.Uuid
  approvedAt      DateTime?
  rejectionReason String?
  /// the IOU whose bills this voucher records (cash already left the box when the IOU was issued)
  iouId           String?                 @db.Uuid
  cancelledReason String?
  cancelledAt     DateTime?
  /// the number of the voucher this one was carried to
  carriedToNumber String?
  reimbursementId String?                 @db.Uuid
  createdById     String?                 @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  account         PettyCashAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reimbursement   PettyCashReimbursement? @relation(fields: [reimbursementId], references: [id])

  @@index([accountId])
  @@index([reimbursementId])
  @@index([approvedById])
  @@index([createdById])
}

model PettyCashReimbursement {
  id                  String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId           String             @db.Uuid
  reimbursementNumber String             @unique
  totalAmount         Decimal            @default(0) @db.Decimal(14, 2)
  status              String             @default("PENDING")
  paymentVoucherId    String?            @db.Uuid
  createdById         String?            @db.Uuid
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  account             PettyCashAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vouchers            PettyCashVoucher[]

  @@index([accountId])
  @@index([paymentVoucherId])
  @@index([createdById])
}

/// A person who looks after the petty cash of a site office: records bills, asks for cash, settles IOUs. Access to that box only.
model PettyCashCustodian {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  accountId   String   @db.Uuid
  userId      String   @db.Uuid
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@unique([accountId, userId])
  @@index([userId])
}
