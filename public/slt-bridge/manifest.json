{
    "manifest_version": 3,
    "name": "SLT-ERP Bridge",
    "version": "4.5.1",
    "description": "High-Precision SLT Portal to ERP Sync Bridge",
    "permissions": [
        "storage",
        "tabs",
        "activeTab",
        "alarms",
        "cookies"
    ],
    "host_permissions": [
        "https://serviceportal.slt.lk/*",
        "https://*.slt.lk/*",
        "http://localhost/*",
        "http://localhost:*/*",
        "https://localhost/*",
        "https://localhost:*/*",
        "http://127.0.0.1/*",
        "http://127.0.0.1:*/*",
        "https://127.0.0.1/*",
        "https://127.0.0.1:*/*",
        "https://d2ixqikwtprwf0.cloudfront.net/*",
        "https://sltserp.vercel.app/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icon.png"
    },
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://serviceportal.slt.lk/*",
                "https://ishamp.slt.lk/*",
                "https://*.slt.lk/*"
            ],
            "js": ["content-slt.js"],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "http://localhost/*",
                "http://localhost:*/*",
                "https://localhost/*",
                "https://localhost:*/*",
                "http://127.0.0.1/*",
                "http://127.0.0.1:*/*",
                "https://127.0.0.1/*",
                "https://127.0.0.1:*/*",
                "https://d2ixqikwtprwf0.cloudfront.net/*",
                "https://sltserp.vercel.app/*"
            ],
            "js": ["content-erp.js"],
            "run_at": "document_start"
        },
        {
            "matches": [
                "http://localhost/*",
                "http://localhost:*/*",
                "https://localhost/*",
                "https://localhost:*/*",
                "http://127.0.0.1/*",
                "http://127.0.0.1:*/*",
                "https://127.0.0.1/*",
                "https://127.0.0.1:*/*",
                "https://d2ixqikwtprwf0.cloudfront.net/*",
                "https://sltserp.vercel.app/*"
            ],
            "js": ["content-main.js"],
            "run_at": "document_end",
            "world": "MAIN"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": ["icon.png", "popup.html"],
            "matches": [
                "https://serviceportal.slt.lk/*",
                "https://*.slt.lk/*",
                "https://sltserp.vercel.app/*",
                "https://d2ixqikwtprwf0.cloudfront.net/*"
            ]
        }
    ]
}
