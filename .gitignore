# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
test-*.png
build-output.txt

# next.js
/.next/
/out/

# production
/build
/dist/
dist/installer/*.exe
scripts/extension/installer/bin/
scripts/extension/installer/obj/

# misc
.DS_Store
*.pem
*.zip
deploy.zip
# the Windows agent installer lives on GitHub releases, never in the deploy
public/downloads/*.exe

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test files
test_*.js
test_*.ts
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# temporary and local files
temp_*.txt
temp_*.env
*.log

# playwright
playwright-report/
test-results/
.auth/

# database files
*.sql
setup_*.sql
repair_*.ps1
# Prisma migrations must always be tracked (global *.sql rule above would ignore them)
!prisma/migrations/**/*.sql

# generated Prisma schema docs (build artifact, ~80MB)
docs/prisma/

# performance and scalability docs (if generated)
PERFORMANCE_*.md
SCALABILITY_*.md

.vercel

# geopackage files
*.gpkg

# monitoring binaries
monitoring/prometheus-bin/

# temporary test/check scripts and HAR dumps
*.har
check*.js
scratch*.ts
tsc_errors_*.txt

# agent debug artifacts (screenshots, temp outputs)
.agent/artifacts/

# root-level test screenshots (ad-hoc QA artifacts)
test-*.png

# SSH keypairs for the sync VPS (private keys must never be committed; .next is
# wiped by every build, so keys live here instead)
.ssh-vps/


deploy_staging/
