# Supabase PostgreSQL - CONNECTION BUDGET (read before raising any number here)
# The session-mode pooler caps pool_size SERVER connections for the WHOLE project (15 today), and
# session mode holds one server connection per client connection. Every process shares that one
# ceiling: VPS web+worker, Vercel lambdas, this local dev server, prisma migrate, one-off scripts.
# src/lib/prisma.ts clamps each client to a share (worker 4 | persistent web 4 | serverless 3 per
# instance | local dev 2, override with DB_CONNECTION_LIMIT) and a URL value may only lower it.
# Keep the sum of all hosts' shares under DB_POOL_CEILING, otherwise sync and web fail with
# FATAL: (EMAXCONNSESSION) max clients reached in session mode.
DATABASE_URL="postgresql://postgres.your_project_ref:your_password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?connection_limit=4"
DIRECT_URL="postgresql://postgres.your_project_ref:your_password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Supabase (Read Replica)
# READ_REPLICA_URL only earns a second client when it points at a DIFFERENT database.
# A URL that differs from DATABASE_URL by query params alone is the same Postgres, and the
# duplicate used to cost 4 of the 15 shared sessions for zero read scaling.
# READ_REPLICA_URL="postgresql://postgres.your_project_ref:your_password@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?connection_limit=4"

JWT_SECRET="your-jwt-secret-here"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Local development: use localhost
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Background Workers
ENABLE_SOD_AUTO_COMPLETE="true"
ENABLE_REMOTE_DB_ACCESS="true"
DISABLE_BACKGROUND_WORKERS="true"

# Supabase Client Variables
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

